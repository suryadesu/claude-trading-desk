# One Alpaca paper account per bot, so each has its own equity curve and the
# leaderboard means something. One paper account per Alpaca login: three signups.
ORB_ALPACA_KEY=
ORB_ALPACA_SECRET=
INSIDER_ALPACA_KEY=
INSIDER_ALPACA_SECRET=
PEAD_ALPACA_KEY=
PEAD_ALPACA_SECRET=

# The lvl bot needs no broker: live CME data in, simulated fills out.
DATABENTO_API_KEY=

# The decision model: Laya, self-hosted by the `laya` service. Free, no signup.
# typed-decisions is the fine-tuned checkpoint (1024-token context); english
# reads only 512 tokens, multilingual 1024. Changing it changes the model, so
# recalibrate and start a fresh decision cache.
MODEL_NAME=typed-decisions
# Pin once calibrated, e.g. LAYA_VERSION=0.9.0. Empty = latest on PyPI.
LAYA_VERSION=
# Optional. The service has no published port, so a key only matters if you expose it.
LAYA_API_KEY=
# From core/calibrate.py on the in-sample half. Placeholders until you run it.
ORB_MODEL_THRESHOLD=0.30
ORB_MODEL_TEMPERATURE=1.0

# Only for comparing against hosted TypeSafe Jev (the `jev` arm). Not needed to run.
TYPESAFE_API_KEY=

# Optional: push state to a Cloudflare Worker so the public dashboard can read it
DASHBOARD_PUSH_URL=
DASHBOARD_PUSH_TOKEN=
