# ---------------------------------------------------------------- Angel One
# Free with an Angel One account. Used for NSE bars (backtests and the live bot)
# and, only with --real-money, for orders. Never commit the filled-in .env.
#
# ANGEL_API_KEY      smartapi.angelone.in -> sign in -> My Apps -> Create App.
#                    Use a "Trading APIs" app if you may ever trade for real, and
#                    register your static IP on it (see below).
# ANGEL_CLIENT_CODE  your Angel One client ID
# ANGEL_MPIN         your 4-digit MPIN (SmartAPI logs in with the MPIN, not a password)
# ANGEL_TOTP_SECRET  smartapi.angelone.in/enable-totp -> the text secret shown
#                    under the QR code (not a 6-digit code)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Real orders are refused unless this is set to exactly I_ACCEPT_REAL_LOSSES
# AND --real-money is passed. Leave it empty: the default is simulated fills.
# Real API orders must also come from the static IP registered on your SmartAPI
# app (NSE/SEBI retail algo rules, April 2026).
ANGEL_REAL_MONEY=

# ---------------------------------------------------------------- INDmoney
# Optional alternative to Angel One. Set BROKER=indmoney to use it for bars,
# brokerage (Rs 10 flat per order) and, only with --real-money, orders.
#
# INDSTOCKS_CLIENT_ID    indstocks.com -> API access tokens -> Setup TOTP; the
#                        Client ID is shown after setup
# INDSTOCKS_MPIN         your INDmoney MPIN
# INDSTOCKS_TOTP_SECRET  the text secret shown with the QR code (shown once)
# INDSTOCKS_ACCESS_TOKEN optional: a 24-hour token from the website instead of
#                        the three above
# Only one INDstocks token is live at a time: generating one on the website ends
# the bot's, and the bot then logs in again (at most once a minute).
BROKER=angel
INDSTOCKS_CLIENT_ID=
INDSTOCKS_MPIN=
INDSTOCKS_TOTP_SECRET=
INDSTOCKS_ACCESS_TOKEN=

# Real INDmoney orders are refused unless this is exactly I_ACCEPT_REAL_LOSSES
# AND --real-money is passed. ANGEL_REAL_MONEY does not unlock INDmoney. Orders
# must come from the static IP registered on the indstocks.com API page.
INDSTOCKS_REAL_MONEY=

# ---------------------------------------------------------------- the bot
# Starting capital for the simulator, in rupees.
ORB_SIM_EQUITY=100000
# From core/calibrate.py on the in-sample half. Placeholders until you run it.
ORB_MODEL_THRESHOLD=0.30
ORB_MODEL_TEMPERATURE=1.0

# ---------------------------------------------------------------- the model
# Laya, self-hosted by the `laya` service. Free, no signup.
# typed-decisions is the fine-tuned checkpoint (1024-token context); english
# reads only 512 tokens, multilingual 1024. Changing it changes the model, so
# recalibrate and start a fresh decision cache.
MODEL_NAME=typed-decisions
# Pin once calibrated, e.g. LAYA_VERSION=0.4.0. Empty = latest on PyPI.
LAYA_VERSION=
# Optional. The service has no published port, so a key only matters if you expose it.
LAYA_API_KEY=

# Only for comparing against hosted TypeSafe Jev (the `jev` arm). Not needed to run.
TYPESAFE_API_KEY=

# Optional: push state to a Cloudflare Worker so the public dashboard can read it
DASHBOARD_PUSH_URL=
DASHBOARD_PUSH_TOKEN=
